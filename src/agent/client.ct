(defpackage #:dakusui/client
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:policy #:dakusui/policy))
  (:export #:Client #:connect #:disconnect
           #:send-policy #:send-flag
           #:policy-line))
(in-package #:dakusui/client)

;;; The agent's end of the socket protocol of spec 0001. (R4, R7)
;;;
;;; Each request waits for its reply. A denial event can come first, so the
;;; client passes each event line to a handler and keeps reading.

(cl:defun reply-of (line)
  "Classify one line from the helper: (:event), (:ok), or (:error text)."
  (cl:let ((value (cl:handler-case (com.inuoe.jzon:parse line :max-depth 8)
                    (cl:error () :bad))))
    (cl:flet ((get (key) (cl:and (cl:hash-table-p value) (cl:gethash key value))))
      (cl:cond
        ((cl:not (cl:hash-table-p value)) (cl:list :error "the helper sent a line that is not a JSON object"))
        ((get "event") (cl:list :event))
        ((cl:eq (get "ok") cl:t) (cl:list :ok))
        ((cl:stringp (get "error")) (cl:list :error (get "error")))
        (cl:t (cl:list :error "the helper sent a reply without \"ok\""))))))

(cl:defun exchange (stream line on-event)
  "Send LINE on STREAM and read until the reply. Return NIL on success or a
string that names the problem."
  (cl:handler-case
      (cl:progn
        (cl:write-line line stream)
        (cl:finish-output stream)
        (cl:loop
          (cl:let ((answer (cl:read-line stream cl:nil)))
            (cl:unless answer
              (cl:return "the helper closed the socket"))
            (cl:destructuring-bind (kind cl:&optional why) (reply-of answer)
              (cl:case kind
                (:event (cl:funcall on-event answer))
                (:ok (cl:return cl:nil))
                (cl:t (cl:return (cl:format cl:nil "the helper refused: ~A" why))))))))
    (cl:error (e)
      (cl:let ((cl:*print-pretty* cl:nil))
        (cl:format cl:nil "the helper socket failed: ~A" e)))))

(coalton-toplevel
  (repr :native cl:stream)
  (define-type Stream)

  (define-struct Client
    "The helper socket, and what to do with each denial event line."
    (stream Stream)
    (on-event (String -> Unit)))

  (declare connect (I32 * (String -> Unit) -> Client))
  (define (connect fd on-event)
    "A client on the socket FD. It owns FD from now on."
    ;; Without :dual-channel-p, SBCL treats FD as a file, and a write drops
    ;; the lines it has read ahead, such as a reply or a denial event.
    (Client (lisp (-> Stream) (fd)
              (sb-sys:make-fd-stream fd :input cl:t :output cl:t
                                        :dual-channel-p cl:t
                                        :external-format :utf-8
                                        :buffering :full :auto-close cl:t))
            on-event))

  (declare disconnect (Client -> Unit))
  (define (disconnect c)
    (let stream = (.stream c))
    (lisp (-> Unit) (stream)
      (cl:ignore-errors (cl:close stream))
      Unit))

  (declare request (Client * String -> Result String Unit))
  (define (request c line)
    (let stream = (.stream c))
    (let on-event = (.on-event c))
    (let outcome =
      (lisp (-> (Optional String)) (stream line on-event)
        (cl:let ((why (exchange stream line
                                (cl:lambda (event)
                                  (call-coalton-function on-event event)))))
          (cl:if why
                 (coalton (Some (lisp (-> String) () why)))
                 (coalton None)))))
    (match outcome
      ((None) (Ok Unit))
      ((Some why) (Err why))))

  (declare quoted (String -> String))
  (define (quoted text)
    (lisp (-> String) (text) (com.inuoe.jzon:stringify text)))

  (declare joined (List String -> String))
  (define (joined items)
    (match items
      ((Nil) "")
      ((Cons first rest) (mconcat (Cons first (map (fn (s) (<> "," s)) rest))))))

  (declare kind-json (policy:Kind -> String))
  (define (kind-json kind)
    (match kind
      ((policy:Read) "\"read\"")
      ((policy:Write) "\"write\"")))

  (declare rule-json (policy:Rule -> String))
  (define (rule-json rule)
    (match rule
      ((policy:Rule effect (policy:Kinds first rest) pat)
       (mconcat
        (make-list "{\"effect\":"
                   (match effect
                     ((policy:Allow) "\"allow\"")
                     ((policy:Deny) "\"deny\""))
                   ",\"kinds\":[" (joined (map kind-json (Cons first rest)))
                   "],\"pattern\":" (quoted (policy:pattern-text pat))
                   "}")))))

  (declare policy-line (policy:Policy -> String))
  (define (policy-line pol)
    "The policy request for POL."
    (match pol
      ((policy:Policy rules)
       (mconcat (make-list "{\"op\":\"policy\",\"rules\":["
                           (joined (map rule-json rules))
                           "]}")))))

  (declare send-policy (Client * policy:Policy -> Result String Unit))
  (define (send-policy c pol)
    "Ask the helper to enforce POL. (R4)"
    (request c (policy-line pol)))

  (declare send-flag (Client * I32 -> Result String Unit))
  (define (send-flag c pid)
    "Ask the helper to confine the process PID. (R1)"
    (request c (lisp (-> String) (pid) (cl:format cl:nil "{\"op\":\"flag\",\"pid\":~D}" pid)))))
