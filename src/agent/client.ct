(defpackage #:dakusui/client
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:policy #:dakusui/policy))
  (:export #:Client #:connect #:disconnect #:closed?
           #:send-policy #:send-flag #:send-sync
           #:policy-line))
(in-package #:dakusui/client)

;;; The agent's end of the socket protocol of spec 0001. (R4, R7)
;;;
;;; A reader thread owns the input. It passes each event line to a handler as
;;; it comes, even while no request is pending, and hands each reply to the
;;; request that waits for it. Requests take turns, so replies match them in
;;; order. An SBCL stream is not safe to read and write from two threads at
;;; once, so the writer has its own stream, on a duplicate of the socket.

(cl:defstruct (conn (:constructor %make-conn))
  socket input output thread
  (lock (sb-thread:make-mutex :name "helper replies"))
  (turn (sb-thread:make-mutex :name "helper requests"))
  (arrived (sb-thread:make-waitqueue))
  (replies cl:nil)
  (closed cl:nil))

(cl:defun reply-of (line)
  "Classify one line from the helper: (:event), (:ok), or (:error text)."
  (cl:let ((value (cl:handler-case (com.inuoe.jzon:parse line :max-depth 8)
                    (cl:error () :bad))))
    (cl:flet ((get (key) (cl:and (cl:hash-table-p value) (cl:gethash key value))))
      (cl:cond
        ((cl:not (cl:hash-table-p value)) (cl:list :error "the helper sent a line that is not a JSON object"))
        ((get "event") (cl:list :event))
        ((cl:eq (get "ok") cl:t) (cl:list :ok))
        ((cl:stringp (get "error")) (cl:list :error (get "error")))
        (cl:t (cl:list :error "the helper sent a reply without \"ok\""))))))

(cl:defun read-replies (c on-event)
  "The reader thread: run until the helper closes its end or the read fails."
  (cl:loop
    (cl:let ((line (cl:handler-case (cl:read-line (conn-input c) cl:nil)
                     (cl:error () cl:nil))))
      (cl:unless line
        (sb-thread:with-mutex ((conn-lock c))
          (cl:setf (conn-closed c) cl:t)
          (sb-thread:condition-broadcast (conn-arrived c)))
        (cl:return))
      (cl:let ((reply (reply-of line)))
        (cl:if (cl:eq (cl:first reply) :event)
               ;; A handler error must not stop the replies.
               (cl:ignore-errors (cl:funcall on-event line))
               (sb-thread:with-mutex ((conn-lock c))
                 (cl:setf (conn-replies c) (cl:append (conn-replies c) (cl:list reply)))
                 (sb-thread:condition-broadcast (conn-arrived c))))))))

(cl:defun make-conn (fd on-event)
  ;; F_DUPFD_CLOEXEC (1030): the copy stays out of commands too.
  (cl:let* ((copy (cffi:foreign-funcall "fcntl" :int fd :int 1030 :int 3 :int))
            (c (%make-conn
                :socket fd
                :input (sb-sys:make-fd-stream fd :input cl:t :external-format :utf-8
                                                 :buffering :full)
                :output (cl:and (cl:>= copy 0)
                                (sb-sys:make-fd-stream copy :output cl:t
                                                            :external-format :utf-8
                                                            :buffering :full)))))
    (cl:setf (conn-thread c)
             (sb-thread:make-thread (cl:lambda () (read-replies c on-event))
                                    :name "helper reader"))
    c))

(cl:defun exchange (c line)
  "Send LINE and wait for its reply. Return NIL on success or a string that
names the problem."
  (sb-thread:with-mutex ((conn-turn c))
    (cl:cond
      ((cl:null (conn-output c)) "the helper socket failed: cannot duplicate it")
      ((sb-thread:with-mutex ((conn-lock c)) (conn-closed c)) "the helper closed the socket")
      (cl:t
       (cl:or
        (cl:handler-case
            (cl:progn
              (cl:write-line line (conn-output c))
              (cl:finish-output (conn-output c))
              cl:nil)
          (cl:error (e)
            (cl:let ((cl:*print-pretty* cl:nil))
              (cl:format cl:nil "the helper socket failed: ~A" e))))
        (sb-thread:with-mutex ((conn-lock c))
          (cl:loop :until (cl:or (conn-replies c) (conn-closed c))
                   :do (sb-thread:condition-wait (conn-arrived c) (conn-lock c)))
          (cl:if (conn-replies c)
                 (cl:destructuring-bind (kind cl:&optional why) (cl:pop (conn-replies c))
                   (cl:if (cl:eq kind :ok)
                          cl:nil
                          (cl:format cl:nil "the helper refused: ~A" why)))
                 "the helper closed the socket")))))))

(cl:defun close-conn (c)
  "Shut the socket, which ends the reader thread, then close both streams."
  ;; SHUT_RDWR (2).
  (cffi:foreign-funcall "shutdown" :int (conn-socket c) :int 2 :int)
  (sb-thread:join-thread (conn-thread c) :default cl:nil)
  (cl:ignore-errors (cl:close (conn-input c)))
  (cl:when (conn-output c)
    (cl:ignore-errors (cl:close (conn-output c)))))

(coalton-toplevel
  (repr :native conn)
  (define-type Client
    "The helper socket and its reader thread.")

  (declare connect (I32 * (String -> Unit) -> Client))
  (define (connect fd on-event)
    "A client on the socket FD, which it owns from now on. ON-EVENT gets each
event line on the reader thread."
    (lisp (-> Client) (fd on-event)
      (make-conn fd (cl:lambda (line) (call-coalton-function on-event line)))))

  (declare disconnect (Client -> Unit))
  (define (disconnect c)
    (lisp (-> Unit) (c)
      (close-conn c)
      Unit))

  (declare closed? (Client -> Boolean))
  (define (closed? c)
    "True once the helper has closed its end. It never reopens. (R9)"
    (lisp (-> Boolean) (c)
      (sb-thread:with-mutex ((conn-lock c)) (cl:and (conn-closed c) cl:t))))

  (declare request (Client * String -> Result String Unit))
  (define (request c line)
    (let outcome =
      (lisp (-> (Optional String)) (c line)
        (cl:let ((why (exchange c line)))
          (cl:if why
                 (coalton (Some (lisp (-> String) () why)))
                 (coalton None)))))
    (match outcome
      ((None) (Ok Unit))
      ((Some why) (Err why))))

  (declare quoted (String -> String))
  (define (quoted text)
    (lisp (-> String) (text) (com.inuoe.jzon:stringify text)))

  (declare joined (List String -> String))
  (define (joined items)
    (match items
      ((Nil) "")
      ((Cons first rest) (mconcat (Cons first (map (fn (s) (<> "," s)) rest))))))

  (declare kind-json (policy:Kind -> String))
  (define (kind-json kind)
    (match kind
      ((policy:Read) "\"read\"")
      ((policy:Write) "\"write\"")))

  (declare rule-json (policy:Rule -> String))
  (define (rule-json rule)
    (match rule
      ((policy:Rule effect (policy:Kinds first rest) pat)
       (mconcat
        (make-list "{\"effect\":"
                   (match effect
                     ((policy:Allow) "\"allow\"")
                     ((policy:Deny) "\"deny\""))
                   ",\"kinds\":[" (joined (map kind-json (Cons first rest)))
                   "],\"pattern\":" (quoted (policy:pattern-text pat))
                   "}")))))

  (declare policy-line (policy:Policy -> String))
  (define (policy-line pol)
    "The policy request for POL."
    (match pol
      ((policy:Policy rules)
       (mconcat (make-list "{\"op\":\"policy\",\"rules\":["
                           (joined (map rule-json rules))
                           "]}")))))

  (declare send-policy (Client * policy:Policy -> Result String Unit))
  (define (send-policy c pol)
    "Ask the helper to enforce POL. (R4)"
    (request c (policy-line pol)))

  (declare send-flag (Client * I32 -> Result String Unit))
  (define (send-flag c pid)
    "Ask the helper to confine the process PID. (R1)"
    (request c (lisp (-> String) (pid) (cl:format cl:nil "{\"op\":\"flag\",\"pid\":~D}" pid))))

  (declare send-sync (Client -> Result String Unit))
  (define (send-sync c)
    "Wait until the helper has sent every denial the kernel has logged so far.
The helper answers only after it drains the ring buffer, and the reader
thread hands each event to the log before it takes the reply. (Spec 0003 R6)"
    (request c "{\"op\":\"sync\"}")))
