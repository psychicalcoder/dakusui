(in-package #:dakusui/policy)

;;; The reference evaluator. Tests compare the kernel's verdicts with it.

(coalton-toplevel
  (declare covers? (Kinds * Kind -> Boolean))
  (define (covers? listed kind)
    (match listed
      ((Kinds first rest) (list:member kind (Cons first rest)))))

  (declare under? (String * String -> Boolean))
  (define (under? prefix path)
    (match (string:strip-prefix (string:concat prefix "/") path)
      ((Some _) True)
      ((None) False)))

  (declare matches? (Pattern * String -> Boolean))
  (define (matches? pat path)
    "True if PAT matches PATH, an absolute path in plain form. (R10)"
    (match pat
      ((PathPrefix "/") True)
      ((PathPrefix prefix) (or (== path prefix) (under? prefix path)))
      ((FileName name) (== (list:last (string:split #\/ path)) (Some name)))))

  (declare last-effect (Policy * Kind * String -> Optional Effect))
  (define (last-effect pol kind path)
    "The effect of the last rule that matches PATH and covers KIND. (R2)"
    (match pol
      ((Policy rules)
       (fold (fn (found r)
               (match r
                 ((Rule effect listed pat)
                  (if (and (covers? listed kind) (matches? pat path))
                      (Some effect)
                      found))))
             None
             rules))))

  (declare allows-kind? (Policy * String * Kind -> Boolean))
  (define (allows-kind? pol path kind)
    (== (last-effect pol kind path) (Some Allow)))

  (declare allows? (Policy * Kinds * String -> Boolean))
  (define (allows? pol wanted path)
    "True if POL allows every kind in WANTED on PATH. Each kind is decided on
its own, and no match denies. (R2, R5)"
    (match wanted
      ((Kinds first rest)
       (list:all (fn (kind) (allows-kind? pol path kind)) (Cons first rest)))))

  (declare path-and-ancestors (String -> List String))
  (define (path-and-ancestors path)
    "PATH, an absolute path in plain form, and each path above it, root first."
    (lisp (-> (List String)) (path)
      (cl:if (cl:string= path "/")
             (cl:list "/")
             (cl:cons "/"
                      (cl:loop :for i := (cl:position #\/ path :start 1)
                                 :then (cl:position #\/ path :start (cl:1+ i))
                               :collect (cl:subseq path 0 (cl:or i (cl:length path)))
                               :while i)))))

  (declare held-paths (Policy -> List String))
  (define (held-paths pol)
    "The paths a confined process may not rename: each path that a path deny
rule names, of any kind, and every ancestor of one, whatever rules come later.
A later allow does not unmark a path, since moving it would still carry the
deny rule's files away; an allow rule alone marks nothing. A name rule marks
nothing either: it matches its name wherever the file goes, so no rename
escapes it, and marking for it would mark every directory. (R6)"
    (match pol
      ((Policy rules)
       (fold (fn (found r)
               (match r
                 ((Rule effect _ (PathPrefix path))
                  (if (== effect Deny)
                      (fold (fn (acc p) (if (list:member p acc) acc (<> acc (make-list p))))
                            found
                            (path-and-ancestors path))
                      found))
                 (_ found)))
             Nil
             rules))))

  (declare held? (Policy * String -> Boolean))
  (define (held? pol path)
    "True if PATH is one of held-paths. (R6)"
    (list:member path (held-paths pol)))

  (declare allows-rename? (Policy * String * String -> Boolean))
  (define (allows-rename? pol old new)
    "True if POL lets a confined process rename OLD to NEW: both need read and
write (R5), and neither may be held (R6). Renaming over NEW, or swapping the
two, asks the same."
    (let both = (Kinds Read (make-list Write)))
    (and (allows? pol both old) (allows? pol both new)
         (not (held? pol old)) (not (held? pol new)))))
