(defpackage #:dakusui/enforcer
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:libbpf #:dakusui/libbpf)
                    (#:policy #:dakusui/policy)
                    (#:list #:coalton/list)
                    (#:string #:coalton/string))
  (:export #:open-enforcer #:read-lsm-list #:start
           #:check-capacity #:install-policy))
(in-package #:dakusui/enforcer)

;;; The enforcer, embedded in the image. (R11)
;;;
;;; Loading this file reads build/enforce.bpf.o, so the bytes are in the image
;;; that `make build` saves. The binary that holds the capabilities never reads
;;; an object from disk, so no one can swap the object.

(cl:defparameter *enforcer-octets*
  (cl:let ((path (asdf:system-relative-pathname "dakusui" "build/enforce.bpf.o")))
    (cl:unless (cl:probe-file path)
      (cl:error "~A is missing. Run `make bpf` first." path))
    (cl:with-open-file (in path :element-type '(cl:unsigned-byte 8))
      (cl:let ((octets (cl:make-array (cl:file-length in)
                                      :element-type '(cl:unsigned-byte 8))))
        (cl:read-sequence octets in)
        octets))))

(coalton-toplevel
  (declare open-enforcer (Void -> Result String libbpf:BpfObject))
  (define (open-enforcer)
    "Open the embedded enforcer, ready to load."
    (libbpf:open-object (lisp (-> libbpf:Octets) () *enforcer-octets*)))

  (declare lsm-file String)
  (define lsm-file "/sys/kernel/security/lsm")

  (declare read-lsm-list (Void -> Result String String))
  (define (read-lsm-list)
    "The kernel's active LSMs, as the comma-separated text of lsm-file."
    (lisp (-> (Result String String)) (lsm-file)
      (cl:handler-case
          (cl:let ((text (uiop:read-file-string lsm-file)))
            (coalton (Ok (lisp (-> String) () text))))
        (cl:error (e)
          (cl:let ((why (cl:princ-to-string e)))
            (coalton (Err (lisp (-> String) () why))))))))

  (declare start (String -> Result String libbpf:BpfObject))
  (define (start lsm-list)
    "Check LSM-LIST, then load the enforcer and attach every program. Each
failure is an Err that says which step failed. (R9)"
    (let active =
      (lisp (-> String) (lsm-list)
        (cl:string-trim '(#\Newline #\Space) lsm-list)))
    (if (not (list:member "bpf" (string:split #\, active)))
        (Err (mconcat (make-list "bpf is not an active LSM, so nothing can be enforced. "
                                 "Active: " active ". "
                                 "Add bpf to the lsm= boot parameter.")))
        (match (do
                (obj <- (open-enforcer))
                (libbpf:load-object obj)
                (libbpf:attach-all obj)
                (pure obj))
          ((Ok obj) (Ok obj))
          ((Err why) (Err (<> "cannot start the enforcer: " why))))))

  (declare check-capacity (UFix * UFix -> Result String Unit))
  (define (check-capacity patterns limit)
    (if (> patterns limit)
        (Err (lisp (-> String) (patterns limit)
               (cl:format cl:nil "the policy has ~D patterns, but the rule map holds ~D"
                          patterns limit)))
        (Ok Unit)))

  (declare fill-map (libbpf:BpfMap * List policy:Entry -> Result String Unit))
  (define (fill-map inner entries)
    (map (const Unit)
         (traverse (fn (entry)
                     (libbpf:map-update inner
                                        (policy:entry-key-bytes entry)
                                        (policy:entry-value-bytes entry)))
                   entries)))

  (declare install-policy (libbpf:BpfObject * policy:Policy -> Result String Unit))
  (define (install-policy obj pol)
    "Compile POL into a new inner map and swap it into the rule map's one slot.
The swap is atomic, so no command sees half a policy, and the next open uses
the new one. On any failure the old policy stays in force. (R4)"
    (match (do
            (entries <- (policy:compile-policy pol))
            ;; inner_template fixes the shape that the kernel accepts in the slot.
            (template <- (libbpf:find-map obj "inner_template"))
            (check-capacity (list:length entries) (libbpf:map-capacity template))
            (outer <- (libbpf:find-map obj "rules"))
            (inner <- (libbpf:create-hash-map-like template))
            (let swapped = (do
                            (fill-map inner entries)
                            (libbpf:map-set-inner outer inner)))
            ;; The slot holds its own reference to the inner map.
            (let _ = (libbpf:close-map inner))
            swapped)
      ((Ok _) (Ok Unit))
      ((Err why) (Err (<> "cannot install the policy: " why))))))
