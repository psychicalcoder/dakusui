(defpackage #:dakusui/check-agent
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:agent #:dakusui/agent)
                    (#:client #:dakusui/client)
                    (#:session #:dakusui/session)
                    (#:launch #:dakusui/launch)
                    (#:denials #:dakusui/denials)
                    (#:string #:coalton/string)
                    (#:list #:coalton/list))
  (:export #:main))
(in-package #:dakusui/check-agent)

;;; A stand-in for dakusui-agent, built from the agent's own code. make
;;; attach-check puts it next to a copy of the real helper, which starts it as
;;; it starts the real agent. It builds a temp project, sends the default
;;; policy, and runs A13, A1, A2, A6, and A19 through the launcher. (T17, T18,
;;; T29, R1, R7, R9, R11) The agent first reads .env itself, so only the policy
;;; can deny it.

(cl:defun make-project ()
  "A temp project with .env and src/a.c. The agent is not confined."
  (cl:let ((base (cffi:with-foreign-string (template "/tmp/dakusui-check-XXXXXX")
                   (cffi:foreign-string-to-lisp
                    (cffi:foreign-funcall "mkdtemp" :pointer template :pointer)))))
    (cl:ensure-directories-exist (cl:format cl:nil "~A/src/" base))
    (cl:with-open-file (out (cl:format cl:nil "~A/.env" base) :direction :output)
      (cl:write-line "SECRET=check" out))
    (cl:with-open-file (out (cl:format cl:nil "~A/src/a.c" base) :direction :output)
      (cl:write-line "int main(void) { return 0; }" out))
    base))

(coalton-toplevel
  (declare say (String -> Unit))
  (define (say text)
    (lisp (-> Unit) (text)
      (cl:write-line text)
      (cl:finish-output)
      Unit))

  (declare readable? (String -> Boolean))
  (define (readable? path)
    "True if this unconfined process can read PATH."
    (lisp (-> Boolean) (path)
      (cl:and (cl:ignore-errors (cl:with-open-file (in path) (cl:read-line in cl:nil ""))) cl:t)))

  (define-type Wanted
    (Succeeds String)
    (Fails String))

  (declare check (client:Client * String * String * String * Wanted -> Boolean))
  (define (check helper project label command wanted)
    "Run COMMAND in PROJECT, and report whether it ended as WANTED says: with
code 0 and the text in its output, or with another code and the text."
    (match (launch:run-command helper project command)
      ((Err why)
       (say (mconcat (make-list "FAIL " label ": " why)))
       False)
      ((Ok o)
       (let code = (launch:outcome-code o))
       (let output = (launch:outcome-output o))
       (let passed =
         (match wanted
           ((Succeeds text) (and (== code 0) (string:substring? text output)))
           ((Fails text) (and (/= code 0) (string:substring? text output)))))
       (say (mconcat (make-list (if passed "ok   " "FAIL ") label
                                (lisp (-> String) (code) (cl:format cl:nil " (exit ~D): " code))
                                output)))
       passed)))

  (declare log-lines (String -> List String))
  (define (log-lines path)
    (lisp (-> (List String)) (path)
      (cl:with-open-file (in path :if-does-not-exist cl:nil)
        (cl:if in
               (cl:loop :for line := (cl:read-line in cl:nil) :while line :collect line)
               cl:nil))))

  (declare check-a13 (client:Client * String * String -> Boolean))
  (define (check-a13 helper project log-file)
    "A denied cat gives one log line naming the process, path, and kind. The
event comes on the reader thread, so wait for it, then a little more, in case
a second line follows."
    (let before = (list:length (log-lines log-file)))
    (let ran = (launch:run-command helper project "cat .env"))
    (lisp (-> Unit) (log-file before)
      (cl:loop :repeat 200
               :until (cl:> (cl:length (coalton (log-lines (lisp (-> String) () log-file)))) before)
               :do (cl:sleep 0.01))
      (cl:sleep 0.3)
      Unit)
    (let new = (list:drop before (log-lines log-file)))
    (let wanted = (mconcat (make-list "denied read of " project "/.env by cat (pid ")))
    (let passed = (and (== 1 (list:length new))
                       (string:substring? wanted (with-default "" (list:head new)))
                       (match ran ((Ok o) (/= 0 (launch:outcome-code o))) ((Err _) False))))
    (say (mconcat (make-list (if passed "ok   " "FAIL ") "A13 one log line for a denied cat: "
                             (mconcat (map (fn (line) (<> line "; ")) new)))))
    passed)

  (declare check-a6 (client:Client * String -> Boolean))
  (define (check-a6 helper project)
    "Stop the helper, our parent, then ask to run a command. Dakusui must
refuse, and the command must not run. This ends the helper, so it comes last."
    (let marker = (<> project "/ran"))
    (let gone? = (fn () (client:closed? helper)))
    (lisp (-> Unit) (gone?)
      (cffi:foreign-funcall "kill" :int (cffi:foreign-funcall "getppid" :int)
                            :int 9 :int)
      (cl:loop :repeat 200
               :until (call-coalton-function gone?)
               :do (cl:sleep 0.01))
      Unit)
    (let ran = (launch:run-command helper project (<> "touch " marker)))
    (let passed = (and (client:closed? helper)
                       (match ran
                         ((Err why) (string:substring? "refused" why))
                         ((Ok _) False))
                       (not (readable? marker))))
    (say (mconcat (make-list (if passed "ok   " "FAIL ") "A6 the helper is stopped: "
                             (match ran ((Err why) why) ((Ok _) "the command ran")))))
    passed)

  (declare a19-script String)
  (define a19-script
    "A19's victim: a confined command in its own session that outlives the
helper, whose pid is $1. It opens its report, a19, while the helper lives,
since every open fails once it is gone, and starts sleep for the same reason.
Then it waits for the helper to go, tries to read src/a.c, and waits on."
    "exec 5>>a19; sleep 600 & echo \"victim $$ $!\" >&5; while kill -0 \"$1\"; do :; done; if read -r _ < src/a.c; then echo \"a19 read\" >&5; else echo \"a19 denied\" >&5; fi; wait")

  (declare start-a19 (client:Client * String -> Boolean))
  (define (start-a19 helper project)
    "Start A19's victim through the launcher, before A6 kills the helper, and
wait until it reports. The command returns once it has put the victim in the
background, and an exec after the helper is gone fails, so killing the
helper sooner could stop the victim before it starts."
    (let helper-pid = (lisp (-> I32) () (cffi:foreign-funcall "getppid" :int)))
    (let command =
      (mconcat (make-list "setsid sh -c '" a19-script "' sh "
                          (lisp (-> String) (helper-pid) (cl:format cl:nil "~D" helper-pid))
                          " </dev/null >/dev/null 2>&1 &")))
    (match (launch:run-command helper project command)
      ((Err why)
       (say (<> "FAIL A19 cannot start the victim: " why))
       False)
      ((Ok _)
       (let report = (<> project "/a19"))
       (let started =
         (lisp (-> Boolean) (report)
           (cl:loop :repeat 500
                    :when (cl:find-if (cl:lambda (l) (uiop:string-prefix-p "victim " l))
                                      (coalton (log-lines (lisp (-> String) () report))))
                      :do (cl:return cl:t)
                    :do (cl:sleep 0.01)
                    :finally (cl:return cl:nil))))
       (if started
           True
           (progn (say "FAIL A19 the victim never reported") False)))))

  (declare check-a19 (String -> Boolean))
  (define (check-a19 project)
    "The first half of A19: once the helper is gone, the victim's read of
src/a.c fails. Print the victim's pids, so the second half can check that
the next start ends them."
    (let report = (<> project "/a19"))
    (let lines = (lisp (-> (List String)) (report)
                   (cl:loop :repeat 300
                            :for lines := (coalton (log-lines (lisp (-> String) () report)))
                            :until (cl:find-if (cl:lambda (l) (uiop:string-prefix-p "a19 " l)) lines)
                            :do (cl:sleep 0.01)
                            :finally (cl:return lines))))
    (let passed = (and (list:member "a19 denied" lines) (not (list:member "a19 read" lines))))
    (let _ = (map (fn (line) (if (string:substring? "victim " line) (say line) Unit)) lines))
    (say (mconcat (make-list (if passed "ok   " "FAIL ")
                             "A19 a command that outlives the helper cannot read src/a.c: "
                             (mconcat (map (fn (line) (<> line "; ")) lines)))))
    passed)

  (declare pid-gone? (String -> Boolean))
  (define (pid-gone? pid)
    "True once process PID has no task, or only a zombie, within a second."
    (lisp (-> Boolean) (pid)
      (cl:loop :repeat 100
               :for text := (cl:ignore-errors (uiop:read-file-string (cl:format cl:nil "/proc/~A/stat" pid)))
               :for close := (cl:and text (cl:position #\) text :from-end cl:t))
               :when (cl:or (cl:null close)
                            (cl:member (cl:char text (cl:+ 2 close)) '(#\Z #\X)))
                 :do (cl:return cl:t)
               :do (cl:sleep 0.01)
               :finally (cl:return cl:nil))))

  (declare check-next-start (client:Client * String * String -> Boolean))
  (define (check-next-start helper project victims)
    "The second half of A19 (T30): this start ended the victims, whose pids
are VICTIMS. Then, for T31, start a nohup'd command, which the helper's
normal exit must end, and print its pid and the helper's."
    (let pids = (list:filter (fn (p) (/= p "")) (string:split #\Space victims)))
    (let ended = (and (not (list:null? pids)) (list:all pid-gone? pids)))
    (say (mconcat (make-list (if ended "ok   " "FAIL ")
                             "A19 the next start ended the victim: " victims)))
    (let nohup = (launch:run-command helper project "nohup sleep 600 </dev/null >/dev/null 2>&1 & echo $!"))
    (let started =
      (match nohup
        ((Ok o)
         (let output = (launch:outcome-output o))
         (let pid = (lisp (-> String) (output) (cl:string-trim '(#\Newline #\Space) output)))
         (say (<> "nohup " pid))
         (say (<> "helper " (lisp (-> String) () (cl:format cl:nil "~D" (cffi:foreign-funcall "getppid" :int)))))
         (/= pid ""))
        ((Err why)
         (say (<> "FAIL T31 cannot start a nohup'd command: " why))
         False)))
    (and ended started))

  (declare checks (client:Client * String -> List Boolean))
  (define (checks helper project)
    (let run = (fn (label command wanted) (check helper project label command wanted)))
    (make-list
     (run "A1 cat .env is denied" "cat .env" (Fails "Permission denied"))
     (run "A1 cat src/a.c succeeds" "cat src/a.c" (Succeeds "int main"))
     (run "A2 python opens .env" "python3 -c 'print(open(\".env\").read())'"
          (Fails "PermissionError"))
     (run "A2 a grandchild is confined" "sh -c 'sh -c \"cat .env\"'" (Fails "Permission denied"))
     (run "a command gets PATH" "env" (Succeeds "PATH="))
     (run "no API key reaches a command" "env | grep -c -e OPENAI_API_KEY -e BASH_ENV"
          (Fails "0"))))

  (declare run-all (client:Client * String * String -> List Boolean))
  (define (run-all helper project log-file)
    "A13 first, so no earlier denial can reach its log. A6 ends the helper, so
it comes last but for A19, whose victim must outlive the helper."
    (let a13 = (check-a13 helper project log-file))
    (let rest = (checks helper project))
    (let victim = (start-a19 helper project))
    (let a6 = (check-a6 helper project))
    (let a19 = (and victim (check-a19 project)))
    (Cons a13 (<> rest (make-list a6 a19))))

  (declare main (Void -> UFix))
  (define (main)
    (let project = (lisp (-> String) () (make-project)))
    (let home = (lisp (-> String) () (cl:or (sb-ext:posix-getenv "HOME") "")))
    ;; Beside the project, not in it, and not in the user's own log.
    (let log-file = (<> project ".denials.log"))
    (let outcome =
      (do
       (agent:harden)
       (let helper = (client:connect 3 (denials:open-log log-file)))
       (session:start helper project home)
       (match (lisp (-> (Optional String)) ()
                (cl:let ((v (sb-ext:posix-getenv "DAKUSUI_CHECK_VICTIMS")))
                  (cl:if v (coalton (Some (lisp (-> String) () v))) (coalton None))))
         ((Some victims) (Ok (make-list (check-next-start helper project victims))))
         ((None)
          (if (readable? (<> project "/.env"))
              (Ok (run-all helper project log-file))
              (Err "the check agent cannot read its own .env"))))))
    (lisp (-> Unit) (project log-file)
      (uiop:delete-directory-tree (cl:pathname (cl:format cl:nil "~A/" project))
                                  :validate cl:t :if-does-not-exist :ignore)
      (cl:ignore-errors (cl:delete-file log-file))
      Unit)
    (match outcome
      ((Err why)
       (say (<> "check-agent: " why))
       1)
      ((Ok results)
       (if (list:all id results)
           (progn (say "check-agent passed: every check held under the real helper") 0)
           (progn (say "check-agent: failed") 1))))))
