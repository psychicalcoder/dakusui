(in-package #:dakusui/test)

;;; T18: log each denial with the process, path, and access kind. (R7) The
;;; client reads events on its own thread, so a denial is logged even while
;;; no request is pending. make attach-check runs A13 under the real helper.

(coalton-toplevel
  (declare event-line (String * String * String * String -> String))
  (define (event-line comm hook kind path)
    (mconcat (make-list "{\"event\":\"denial\",\"pid\":42,\"comm\":" (quoted-json comm)
                        ",\"hook\":\"" hook "\",\"kind\":\"" kind
                        "\",\"reason\":\"denied by rule\",\"path\":" (quoted-json path) "}")))

  (declare quoted-json (String -> String))
  (define (quoted-json text)
    (lisp (-> String) (text) (com.inuoe.jzon:stringify text)))

  (declare wait-until ((Void -> Boolean) -> Boolean))
  (define (wait-until done?)
    "Poll DONE? for up to two seconds."
    (lisp (-> Boolean) (done?)
      (cl:loop :repeat 200
               :when (call-coalton-function done?) :return cl:t
               :do (cl:sleep 0.01)
               :finally (cl:return (call-coalton-function done?)))))

  (declare file-lines (String -> List String))
  (define (file-lines path)
    (lisp (-> (List String)) (path)
      (cl:with-open-file (in path :if-does-not-exist cl:nil)
        (cl:if in
               (cl:loop :for line := (cl:read-line in cl:nil) :while line :collect line)
               cl:nil)))))

(define-test denial-text-names-process-path-and-kind ()
  (is (== (Some "denied read of /p/.env by cat (pid 42): denied by rule")
          (denials:denial-text (event-line "cat" "file_open" "read" "/p/.env"))))
  (is (== (Some "denied read,write of /p/x by sh (pid 42): denied by rule")
          (denials:denial-text (event-line "sh" "file_open" "read,write" "/p/x"))))
  (is (== (Some "denied path_link by ln (pid 42): denied by rule")
          (denials:denial-text (event-line "ln" "path_link" "none" ""))))
  (is (== None (denials:denial-text "{\"ok\":true}")))
  (is (== None (denials:denial-text "{\"event\":\"denial\",\"pid\":\"42\"}")))
  (is (== None (denials:denial-text "not json"))))

;; A command names itself and its files, so it must not forge a log line.
(define-test denial-text-keeps-one-line ()
  (is (== (Some "denied read of /p/a\\x0Ab by x\\x0Adakusui: denied (pid 42): denied by rule")
          (denials:denial-text (event-line "x
dakusui: denied" "file_open" "read" "/p/a
b")))))

(define-test open-log-appends-a-timestamped-line ()
  (let base = (temp-tree Nil Nil Nil))
  (let path = (<> base "/state/dakusui/denials.log"))
  (let log = (denials:open-log path))
  (log (event-line "cat" "file_open" "read" "/p/.env"))
  (log "{\"event\":\"other\"}")
  (log (event-line "cat" "file_open" "write" "/etc/hostname"))
  (let lines = (file-lines path))
  (is (== 2 (list:length lines)))
  (is (string:substring? "Z denied read of /p/.env by cat (pid 42)" (with-default "" (list:index 0 lines))))
  (is (string:substring? "Z denied write of /etc/hostname" (with-default "" (list:index 1 lines))))
  (remove-tree base))

(define-test client-reads-events-with-no-request-pending ()
  (let event = (event-line "cat" "file_open" "read" "/p/.env"))
  (let fake = (fake-helper (make-list event event) False))
  (let events = (cell:new Nil))
  (let c = (client:connect (.agent fake) (fn (line) (cell:push! events line) Unit)))
  (is (wait-until (fn () (== 2 (list:length (cell:read events))))))
  (requests-of fake c)
  Unit)

(define-test client-survives-a-failing-handler ()
  (let event = (event-line "cat" "file_open" "read" "/p/.env"))
  (let fake = (fake-helper (make-list event "{\"ok\":true}") False))
  (let c = (client:connect (.agent fake)
                           (fn (_) (lisp (-> Unit) () (cl:error "handler failed")))))
  (is (== (Ok Unit) (client:send-flag c 5)))
  (requests-of fake c)
  Unit)

(define-test client-fails-every-request-once-the-helper-is-gone ()
  (let fake = (fake-helper Nil True))
  (let c = (client:connect (.agent fake) ignore-event))
  (is (== (Err "the helper closed the socket") (client:send-flag c 5)))
  (is (== (Err "the helper closed the socket") (client:send-flag c 6)))
  (requests-of fake c)
  Unit)
