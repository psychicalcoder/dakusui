(defpackage #:dakusui/attach-check
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:libbpf #:dakusui/libbpf)
                    (#:enforcer #:dakusui/enforcer)
                    (#:pins #:dakusui/pins)
                    (#:spawn #:dakusui/spawn)
                    (#:serve #:dakusui/serve)
                    (#:string #:coalton/string)
                    (#:policy #:dakusui/policy)
                    (#:cell #:coalton/cell)
                    (#:list #:coalton/list))
  (:export #:main))
(in-package #:dakusui/attach-check)

;;; The check for T8 through T14, and T28. Start the enforcer embedded in this image, then
;;; run commands confined to show that policies, live swaps (A4), and denial
;;; records work. Then start stand-in agents to show the agent holds nothing and
;;; the helper serves it. It needs CAP_BPF and CAP_PERFMON, so it runs through
;;; `make attach-check`, not `make test`.

(coalton-toplevel
  (repr :native sb-impl::process)
  (define-type Process)

  (declare say (String -> Unit))
  (define (say text)
    (lisp (-> Unit) (text)
      (cl:write-line text)
      (cl:finish-output)
      Unit))

  (declare expected-programs (List String))
  (define expected-programs
    (make-list "e_inherit" "e_file_open" "e_file_truncate" "e_path_truncate"
               "e_path_mknod" "e_path_mkdir" "e_path_rmdir" "e_path_unlink"
               "e_path_symlink" "e_path_rename" "e_path_link" "e_userns_create"
               "e_ptrace_access_check"))

  (declare check-names (String * List String -> Result String Unit))
  (define (check-names label names)
    (if (and (== (list:length names) (list:length expected-programs))
             (list:all (fn (name) (list:member name names)) expected-programs))
        (Ok Unit)
        (Err (<> label " the wrong programs"))))

  (declare install (libbpf:BpfObject * List String -> Result String Unit))
  (define (install obj lines)
    "Parse rule text and install it through the helper's path."
    (do
     (rules <- (traverse policy:parse-rule lines))
     (enforcer:install-policy obj (policy:Policy rules))))

  (declare start-shell (String * String -> Process))
  (define (start-shell script file)
    "Run sh -c SCRIPT with FILE as $1. Its stdin and stdout are pipes to us, so
the script can wait for our lines and report to us."
    (lisp (-> Process) (script file)
      (sb-ext:run-program "/bin/sh" (cl:list "-c" script "sh" file)
                          :wait cl:nil :input :stream :output :stream :error cl:nil)))

  (declare send-line (Process -> Unit))
  (define (send-line process)
    (lisp (-> Unit) (process)
      (cl:let ((input (sb-ext:process-input process)))
        (cl:write-line "go" input)
        (cl:finish-output input))
      Unit))

  (declare read-reply (Process -> String))
  (define (read-reply process)
    "The shell's next line of output, or the empty string at its end."
    (lisp (-> String) (process)
      (cl:read-line (sb-ext:process-output process) cl:nil "")))

  (declare wait-exit (Process -> I32))
  (define (wait-exit process)
    "Close the shell's stdin, and return its exit code."
    (lisp (-> I32) (process)
      (cl:close (sb-ext:process-input process))
      (sb-ext:process-wait process)
      (sb-ext:process-exit-code process)))

  (declare flag (libbpf:BpfObject * Process -> Result String Unit))
  (define (flag obj process)
    "T12: flag the shell through the helper's path. We have not reaped it, so
its pid is still its own."
    (enforcer:flag-process obj (lisp (-> I32) (process) (sb-ext:process-pid process))))

  (declare run-confined (libbpf:BpfObject * String -> Result String I32))
  (define (run-confined obj file)
    "Flag a shell before it runs `cat FILE`, and return the exit code."
    (let process = (start-shell "read _ && exec cat \"$1\" >/dev/null" file))
    (do
     (flag obj process)
     (let _ = (send-line process))
     (pure (wait-exit process))))

  (declare check-live-swap (libbpf:BpfObject * List String -> Result String Unit))
  (define (check-live-swap obj before)
    "A4 (R4): a running command fails to read /etc/hostname, then we append an
allow rule, and the same command's next read succeeds."
    (let process =
      (start-shell (mconcat
                    (make-list "read _ || exit 9; "
                               "if cat \"$1\" >/dev/null 2>&1; then echo read; else echo denied; fi; "
                               "read _ && exec cat \"$1\" >/dev/null"))
                   "/etc/hostname"))
    (do
     (flag obj process)
     (let _ = (send-line process))
     (let first = (read-reply process))
     (install obj (<> before (make-list "allow read /etc/hostname")))
     (let _ = (send-line process))
     (let code = (wait-exit process))
     (cond
       ((/= first "denied")
        (Err (<> "A4: before the change, the read gave " first)))
       ((/= code 0)
        (Err "A4: after the change, the running command still could not read"))
       (True (Ok Unit)))))

  (declare denial-path (List U8 -> String))
  (define (denial-path record)
    "The path field of struct denial, which starts at byte 32."
    (lisp (-> String) (record)
      (cl:let* ((field (cl:nthcdr 32 record))
                (end (cl:or (cl:position 0 field) (cl:length field))))
        (sb-ext:octets-to-string
         (cl:coerce (cl:subseq field 0 end) '(cl:vector (cl:unsigned-byte 8)))
         :external-format :utf-8))))

  (declare denial-status (List U8 -> UFix))
  (define (denial-status record)
    "The status field of struct denial, at byte 12."
    (lisp (-> UFix) (record)
      (cl:loop :for i :from 0 :below 4
               :sum (cl:ash (cl:or (cl:nth (cl:+ 12 i) record) 0) (cl:* 8 i)))))

  (declare st-gone UFix)
  (define st-gone 9)

  (declare check-liveness (libbpf:BpfObject -> Result String Unit))
  (define (check-liveness obj)
    "T28 (R9): point the helper map at pid 1, keeping our start time, so the
recorded helper is not us. A confined read the policy allows then fails, with
the reason helper gone. Then point it back at us, and the read succeeds."
    (let statuses = (cell:new Nil))
    (let zero = (make-list 0 0 0 0))
    (do
     (helper <- (libbpf:find-map obj "helper"))
     (ours <- (map (fn (found) (with-default Nil found)) (libbpf:map-lookup helper zero)))
     (let start = (enforcer:helper-start ours))
     (ring <- (do
               (denials <- (libbpf:find-map obj "denials"))
               (libbpf:ring-buffer-new
                denials
                (fn (record)
                  (cell:push! statuses (denial-status record))
                  Unit))))
     (libbpf:map-update helper zero (enforcer:helper-bytes 1 start))
     (gone-code <- (run-confined obj "/etc/passwd"))
     (libbpf:map-update helper zero ours)
     (libbpf:ring-buffer-poll ring 200)
     (back-code <- (run-confined obj "/etc/passwd"))
     (cond
       ((== gone-code 0)
        (Err "T28: a confined read succeeded while the helper map named another task"))
       ((not (list:member st-gone (cell:read statuses)))
        (Err "T28: no denial gave the reason helper gone"))
       ((/= back-code 0)
        (Err "T28: a confined read failed once the helper map named us again"))
       (True (Ok (say "T28 passed: with the helper gone, a confined read was denied"))))))

  (declare check-attached (Void -> Result String libbpf:BpfObject))
  (define (check-attached)
    "The helper's own startup. It fails unless every program attached and
pinned, so it needs the bpffs mount."
    (do
     (lsm-list <- (enforcer:read-lsm-list))
     (enforcer:check-lsm lsm-list)
     (pins:check-system-pins)
     (obj <- (enforcer:start lsm-list))
     (let attached = (libbpf:program-names obj))
     (check-names "the enforcer holds" attached)
     (let _ = (map (fn (name) (say (<> "attached " name))) attached))
     (pure obj)))

  (declare check-enforced (libbpf:BpfObject -> Result String Unit))
  (define (check-enforced obj)
    (let denied = (cell:new Nil))
    ;; The scripts redirect to /dev/null, which is a confined write.
    (let base = (make-list "allow read /" "allow write /dev/null"
                           "deny read name:hostname"))
    (do
     (ring <- (do
               (denials <- (libbpf:find-map obj "denials"))
               (libbpf:ring-buffer-new
                denials
                (fn (record)
                  (cell:push! denied (denial-path record))
                  Unit))))
     (install obj base)
     (allowed-code <- (run-confined obj "/etc/passwd"))
     (denied-code <- (run-confined obj "/etc/hostname"))
     (libbpf:ring-buffer-poll ring 200)
     (let paths = (cell:read denied))
     (cond
       ((/= allowed-code 0)
        (Err "a confined read that the policy allows failed"))
       ((== denied-code 0)
        (Err "a confined read that the policy denies succeeded"))
       ((not (list:member "/etc/hostname" paths))
        (Err "no denial record named /etc/hostname"))
       (True (Ok Unit)))
     (install obj base)
     (check-live-swap obj base)
     (let _ = (say "A4 passed: a running command saw the new policy"))
     (check-liveness obj)))

  (declare read-socket (I32 -> String))
  (define (read-socket fd)
    "Read the socket FD to its end, then close it."
    (lisp (-> String) (fd)
      (cl:with-open-stream (in (sb-sys:make-fd-stream fd :input cl:t
                                                         :external-format :utf-8
                                                         :auto-close cl:t))
        (cl:with-output-to-string (out)
          (cl:loop :for line := (cl:read-line in cl:nil)
                   :while line
                   :do (cl:write-line line out))))))

  (declare check-agent-start (Void -> Result String Unit))
  (define (check-agent-start)
    "T13 (R11): start a stand-in agent the way the helper starts the real one,
while this process holds the capabilities and every BPF descriptor. The child
reports its status and descriptors over its socket."
    (let script =
      (<> "grep -E '^(CapInh|CapPrm|CapEff|CapAmb|CapBnd|NoNewPrivs):' /proc/self/status >&3; "
          "exec 1>&3; exec ls -l /proc/self/fd"))
    (do
     (agent <- (spawn:start-agent "/bin/sh" (make-list "-c" script)))
     (let report = (read-socket (spawn:agent-socket agent)))
     (let zero = (fn (field)
                   (string:substring? (<> field (<> (into #\Tab) "0000000000000000"))
                                      report)))
     (let _ = (spawn:wait-agent agent))
     (let _ = (say report))
     (cond
       ((not (list:all zero (make-list "CapInh:" "CapPrm:" "CapEff:" "CapAmb:")))
        (Err "the agent kept a capability"))
       ((not (string:substring? (<> "NoNewPrivs:" (<> (into #\Tab) "1")) report))
        (Err "the agent can gain privileges on exec"))
       ((string:substring? "bpf" report)
        (Err "the agent inherited a BPF descriptor"))
       ((string:substring? " 5 -> " report)
        (Err "the agent inherited a descriptor beyond fd 3"))
       (True (Ok (say "T13 passed: the agent has no capabilities and only fd 3"))))))

  (declare served-script String)
  (define served-script
    "A stand-in agent. It writes each reply it gets, and then the event for
/etc/hostname, to the file named by $1. Events can come before a reply, so ask
skips them, as the real agent must. Coalton strings, like Lisp's, have no \\n
escape, so the lines break for real."
    "exec 4>\"$1\"
ask() {
  printf '%s\\n' \"$1\" >&3
  while IFS= read -r reply <&3; do
    case $reply in '{\"event\"'*) ;; *) break ;; esac
  done
  printf '%s\\n' \"$reply\" >&4
}
ask 'not json'
ask '{\"op\":\"policy\",\"rules\":[{\"effect\":\"allow\",\"kinds\":[\"read\"],\"pattern\":\"/\"},{\"effect\":\"allow\",\"kinds\":[\"write\"],\"pattern\":\"/dev/null\"},{\"effect\":\"deny\",\"kinds\":[\"read\"],\"pattern\":\"name:hostname\"}]}'
d=$(mktemp -d); mkfifo \"$d/go\"
sh -c 'read _ < \"$1\"; exec cat /etc/hostname' sh \"$d/go\" >/dev/null 2>&1 &
pid=$!
ask \"{\\\"op\\\":\\\"flag\\\",\\\"pid\\\":$pid}\"
echo go > \"$d/go\"; wait \"$pid\"; printf 'exit %s\\n' \"$?\" >&4
timeout 5 sh -c 'while IFS= read -r line; do
  case $line in *'/etc/hostname'*) printf \"%s\\n\" \"$line\"; exit ;; esac
done' <&3 >&4
rm -rf \"$d\"
")

  (declare check-served (libbpf:BpfObject -> Result String Unit))
  (define (check-served obj)
    "T14 (R7): serve a stand-in agent through the helper's own loop. It sends
garbage, a policy, and a flag for its child, which a denial event then reports."
    (let report-file =
      (lisp (-> String) ()
        (cl:format cl:nil "/tmp/dakusui-attach-check-~D" (sb-unix:unix-getpid))))
    (do
     (agent <- (spawn:start-agent "/bin/sh" (make-list "-c" served-script "sh" report-file)))
     (serve:serve-agent obj (spawn:agent-socket agent))
     (let _ = (libbpf:close-fd (spawn:agent-socket agent)))
     (let _ = (spawn:wait-agent agent))
     (let report = (lisp (-> String) (report-file)
                     (cl:prog1 (cl:or (cl:ignore-errors (uiop:read-file-string report-file)) "")
                       (cl:ignore-errors (cl:delete-file report-file)))))
     (let _ = (say report))
     (let lines = (string:split #\Newline report))
     (let line = (fn (n) (with-default "" (list:index n lines))))
     (cond
       ((not (string:substring? "\"ok\":false" (line 0)))
        (Err "garbage did not get an error reply"))
       ((/= (line 1) "{\"ok\":true}")
        (Err "the policy request failed"))
       ((/= (line 2) "{\"ok\":true}")
        (Err "the flag request failed"))
       ((== (line 3) "exit 0")
        (Err "the flagged child read a denied file"))
       ((not (and (string:substring? "\"event\":\"denial\"" (line 4))
                  (string:substring? "\"path\":\"/etc/hostname\"" (line 4))))
        (Err "no denial event for /etc/hostname"))
       (True (Ok (say "T14 passed: the helper served the agent and pushed the denial"))))))

  (declare main (Void -> UFix))
  (define (main)
    (let outcome =
      (do
       (obj <- (check-attached))
       (check-enforced obj)
       (check-agent-start)
       (check-served obj)))
    (match outcome
      ((Ok _)
       (say "attach-check: passed")
       0)
      ((Err message)
       (say (<> "attach-check: " message))
       1))))
