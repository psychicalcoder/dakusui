(defpackage #:dakusui/attach-check
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:libbpf #:dakusui/libbpf)
                    (#:enforcer #:dakusui/enforcer)
                    (#:policy #:dakusui/policy)
                    (#:cell #:coalton/cell)
                    (#:list #:coalton/list))
  (:export #:main))
(in-package #:dakusui/attach-check)

;;; The check for T8 through T11. Start the enforcer embedded in this image, then
;;; run commands confined to show that policies, live swaps (A4), and denial
;;; records work. It needs CAP_BPF and CAP_PERFMON, so it runs through
;;; `make attach-check`, not `make test`.

(coalton-toplevel
  (repr :native sb-impl::process)
  (define-type Process)

  (declare say (String -> Unit))
  (define (say text)
    (lisp (-> Unit) (text)
      (cl:write-line text)
      (cl:finish-output)
      Unit))

  (declare expected-programs (List String))
  (define expected-programs
    (make-list "e_inherit" "e_file_open" "e_file_truncate" "e_path_truncate"
               "e_path_mknod" "e_path_mkdir" "e_path_rmdir" "e_path_unlink"
               "e_path_symlink" "e_path_rename" "e_path_link" "e_userns_create"
               "e_ptrace_access_check"))

  (declare check-names (String * List String -> Result String Unit))
  (define (check-names label names)
    (if (and (== (list:length names) (list:length expected-programs))
             (list:all (fn (name) (list:member name names)) expected-programs))
        (Ok Unit)
        (Err (<> label " the wrong programs"))))

  (declare install (libbpf:BpfObject * List String -> Result String Unit))
  (define (install obj lines)
    "Parse rule text and install it through the helper's path."
    (do
     (rules <- (traverse policy:parse-rule lines))
     (enforcer:install-policy obj (policy:Policy rules))))

  (declare start-shell (String * String -> Process))
  (define (start-shell script file)
    "Run sh -c SCRIPT with FILE as $1. Its stdin and stdout are pipes to us, so
the script can wait for our lines and report to us."
    (lisp (-> Process) (script file)
      (sb-ext:run-program "/bin/sh" (cl:list "-c" script "sh" file)
                          :wait cl:nil :input :stream :output :stream :error cl:nil)))

  (declare send-line (Process -> Unit))
  (define (send-line process)
    (lisp (-> Unit) (process)
      (cl:let ((input (sb-ext:process-input process)))
        (cl:write-line "go" input)
        (cl:finish-output input))
      Unit))

  (declare read-reply (Process -> String))
  (define (read-reply process)
    "The shell's next line of output, or the empty string at its end."
    (lisp (-> String) (process)
      (cl:read-line (sb-ext:process-output process) cl:nil "")))

  (declare wait-exit (Process -> I32))
  (define (wait-exit process)
    "Close the shell's stdin, and return its exit code."
    (lisp (-> I32) (process)
      (cl:close (sb-ext:process-input process))
      (sb-ext:process-wait process)
      (sb-ext:process-exit-code process)))

  (declare pidfd-bytes (Process -> Result String (List U8)))
  (define (pidfd-bytes process)
    "The key of the confined map: a pidfd. 434 is pidfd_open on x86-64."
    (let fd =
      (lisp (-> I32) (process)
        (cffi:foreign-funcall "syscall"
                              :long 434
                              :int (sb-ext:process-pid process)
                              :uint 0
                              :int)))
    (if (< fd 0)
        (Err "pidfd_open failed")
        (Ok (lisp (-> (List U8)) (fd)
              (cl:loop :for shift :from 0 :below 32 :by 8
                       :collect (cl:ldb (cl:byte 8 shift) fd))))))

  (declare flag (libbpf:BpfObject * Process -> Result String Unit))
  (define (flag obj process)
    (do
     (confined <- (libbpf:find-map obj "confined"))
     (key <- (pidfd-bytes process))
     (libbpf:map-update confined key (make-list 1 0 0 0))))

  (declare run-confined (libbpf:BpfObject * String -> Result String I32))
  (define (run-confined obj file)
    "Flag a shell before it runs `cat FILE`, and return the exit code."
    (let process = (start-shell "read _ && exec cat \"$1\" >/dev/null" file))
    (do
     (flag obj process)
     (let _ = (send-line process))
     (pure (wait-exit process))))

  (declare check-live-swap (libbpf:BpfObject * List String -> Result String Unit))
  (define (check-live-swap obj before)
    "A4 (R4): a running command fails to read /etc/hostname, then we append an
allow rule, and the same command's next read succeeds."
    (let process =
      (start-shell (mconcat
                    (make-list "read _ || exit 9; "
                               "if cat \"$1\" >/dev/null 2>&1; then echo read; else echo denied; fi; "
                               "read _ && exec cat \"$1\" >/dev/null"))
                   "/etc/hostname"))
    (do
     (flag obj process)
     (let _ = (send-line process))
     (let first = (read-reply process))
     (install obj (<> before (make-list "allow read /etc/hostname")))
     (let _ = (send-line process))
     (let code = (wait-exit process))
     (cond
       ((/= first "denied")
        (Err (<> "A4: before the change, the read gave " first)))
       ((/= code 0)
        (Err "A4: after the change, the running command still could not read"))
       (True (Ok Unit)))))

  (declare denial-path (List U8 -> String))
  (define (denial-path record)
    "The path field of struct denial, which starts at byte 32."
    (lisp (-> String) (record)
      (cl:let* ((field (cl:nthcdr 32 record))
                (end (cl:or (cl:position 0 field) (cl:length field))))
        (sb-ext:octets-to-string
         (cl:coerce (cl:subseq field 0 end) '(cl:vector (cl:unsigned-byte 8)))
         :external-format :utf-8))))

  (declare check-attached (Void -> Result String libbpf:BpfObject))
  (define (check-attached)
    "The helper's own startup. It fails unless every program attached."
    (do
     (lsm-list <- (enforcer:read-lsm-list))
     (obj <- (enforcer:start lsm-list))
     (let attached = (libbpf:program-names obj))
     (check-names "the enforcer holds" attached)
     (let _ = (map (fn (name) (say (<> "attached " name))) attached))
     (pure obj)))

  (declare check-enforced (libbpf:BpfObject -> Result String Unit))
  (define (check-enforced obj)
    (let denied = (cell:new Nil))
    ;; The scripts redirect to /dev/null, which is a confined write.
    (let base = (make-list "allow read /" "allow write /dev/null"
                           "deny read name:hostname"))
    (do
     (ring <- (do
               (denials <- (libbpf:find-map obj "denials"))
               (libbpf:ring-buffer-new
                denials
                (fn (record)
                  (cell:push! denied (denial-path record))
                  Unit))))
     (install obj base)
     (allowed-code <- (run-confined obj "/etc/passwd"))
     (denied-code <- (run-confined obj "/etc/hostname"))
     (libbpf:ring-buffer-poll ring 200)
     (let paths = (cell:read denied))
     (cond
       ((/= allowed-code 0)
        (Err "a confined read that the policy allows failed"))
       ((== denied-code 0)
        (Err "a confined read that the policy denies succeeded"))
       ((not (list:member "/etc/hostname" paths))
        (Err "no denial record named /etc/hostname"))
       (True (Ok Unit)))
     (install obj base)
     (check-live-swap obj base)
     (pure (say "A4 passed: a running command saw the new policy"))))

  (declare main (Void -> UFix))
  (define (main)
    (let outcome =
      (do
       (obj <- (check-attached))
       (check-enforced obj)))
    (match outcome
      ((Ok _)
       (say "attach-check: passed")
       0)
      ((Err message)
       (say (<> "attach-check: " message))
       1))))
